{
    "name": "Qada — Prayer make-up tracker",
  "short_name": "Qada",
  "description": "Offline tracker for missed prayers with a steady daily make-up plan. No account, no servers.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#06100f",
  "theme_color": "#06100f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["lifestyle", "productivity"],
  "icons": [
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "url": "./#/today"
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "url": "./#/calendar"
    }
  ]
}
