<!--
  Reference copy of the Android-only project file.

  You normally do NOT create this by hand: Visual Studio generates it when you
  create a ".NET MAUI App" project, and you only edit a few lines. Keep this file
  as a reference — or copy it over Qada.csproj if yours is broken.

  ⚠ If your SDK is .NET 10, change net9.0-android to net10.0-android below.
    The quickest way to know: open the generated Qada.csproj and read
    <TargetFramework> / <TargetFrameworks>.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Qada</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Shown under the icon on the home screen -->
    <ApplicationTitle>Qada</ApplicationTitle>

    <!-- Permanent. Never change it after publishing. -->
    <ApplicationId>com.souhaieb.qada</ApplicationId>

    <!-- The version users see -->
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>

    <!-- versionCode: must increase with every release.
         0.2.0 -> 200, 0.2.1 -> 201, 0.3.0 -> 300 -->
    <ApplicationVersion>200</ApplicationVersion>

    <!-- Android 7.0. Service workers and modern WebView need >= 24. -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copy app/assets/icon-1024.png to Resources/AppIcon/appicon.png -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#06100F" />

    <!-- Optional: copy app/assets/favicon.svg to Resources/Splash/splash.svg -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#06100F" BaseSize="128,128" />

    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- $(MauiVersion) comes from the installed MAUI workload; do not pin it. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

</Project>
